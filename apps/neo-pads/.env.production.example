PORT=8788
NODE_ENV=production
NEO_PADS_WEB_ORIGIN=https://example.github.io

# When present, NEO Pads uses PostgreSQL instead of the local memory/JSON repository.
DATABASE_URL=postgres://neo_pads:change-me@postgres:5432/neo_pads

# Protects operational reconciliation endpoints. Use long random values.
NEO_PADS_OPS_TOKEN=
NEO_PADS_ADMIN_TOKEN=

# Wallet signature verification grants a temporary authorization window.
# Default: 86400 seconds (24 hours). Minimum enforced value: 60 seconds.
NEO_PADS_WALLET_VERIFICATION_TTL_SECONDS=86400

COUNTERPARTY_CORE_URL=
COUNTERPARTY_BALANCE_URL=
COUNTERPARTY_API_KEY=
# Public/read-only wallet used only to verify Counterparty adapter reachability and response shape.
NEO_PADS_COUNTERPARTY_CANARY_WALLET=

NEOPASS_API_URL=
NEOWORKS_API_URL=

# NEO Counter's current source-of-truth checkout contract is the browser gateway intent,
# not an assumed POST /checkout runtime API. Point this at the published NEO Counter frontend.
NEO_COUNTER_CHECKOUT_URL=https://example.github.io/neo-system/apps/neo-counter/
# Must contain {bookingId}; NEO Counter redirects here after checkout/cancel.
# Redirect data is not payment proof: NEO Pads must still independently verify settlement.
NEO_PADS_CHECKOUT_RETURN_URL=https://example.github.io/neo-system/apps/neo-pads/booking/{bookingId}
NEO_PADS_CHECKOUT_CANCEL_URL=https://example.github.io/neo-system/apps/neo-pads/booking/{bookingId}

# Optional read-only health/readiness endpoint for a separately deployed NEO Counter runtime.
NEO_COUNTER_HEALTH_URL=
NEO_COUNTER_API_KEY=
NEO_COUNTER_WEBHOOK_SECRET=

# Host payout execution is fail-closed. Keep false until the NEO Counter payout API is configured and approved.
NEO_PADS_PAYOUT_EXECUTION_ENABLED=false
NEO_COUNTER_PAYOUT_API_KEY=

# Payout status reconciliation is read-only. The URL must contain {payoutId}.
NEO_COUNTER_PAYOUT_STATUS_URL=

# Chain confirmation is required by default before a payout becomes SETTLED.
# Set to false only for controlled non-production testing.
NEO_PADS_REQUIRE_CHAIN_CONFIRMATION=true
NEO_PADS_CHAIN_CONFIRMATION_URL=
NEO_PADS_CHAIN_CONFIRMATION_API_KEY=

# Operational escalation threshold for AUTHORIZED/SUBMITTED/FAILED payouts.
NEO_PADS_PAYOUT_STALE_MINUTES=120

WALLET_SIGNATURE_VERIFY_URL=
WALLET_SIGNATURE_VERIFY_API_KEY=
