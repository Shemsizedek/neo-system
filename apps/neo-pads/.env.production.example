PORT=8788
NEO_PADS_WEB_ORIGIN=https://example.github.io

# When present, NEO Pads uses PostgreSQL instead of the local memory/JSON repository.
DATABASE_URL=postgres://neo_pads:change-me@postgres:5432/neo_pads

# Protects operational reconciliation endpoints. Use a long random value.
NEO_PADS_OPS_TOKEN=

COUNTERPARTY_CORE_URL=
COUNTERPARTY_BALANCE_URL=
COUNTERPARTY_API_KEY=
NEOPASS_API_URL=
NEOWORKS_API_URL=
NEO_COUNTER_API_URL=
NEO_COUNTER_WEBHOOK_SECRET=

# Host payout execution is fail-closed. Keep false until the NEO Counter payout API is configured and approved.
NEO_PADS_PAYOUT_EXECUTION_ENABLED=false
NEO_COUNTER_PAYOUT_API_KEY=

# Payout status reconciliation is read-only. The URL must contain {payoutId}.
NEO_COUNTER_PAYOUT_STATUS_URL=

# Chain confirmation is required by default before a payout becomes SETTLED.
# Set to false only for controlled non-production testing.
NEO_PADS_REQUIRE_CHAIN_CONFIRMATION=true
NEO_PADS_CHAIN_CONFIRMATION_URL=
NEO_PADS_CHAIN_CONFIRMATION_API_KEY=

# Operational escalation threshold for AUTHORIZED/SUBMITTED/FAILED payouts.
NEO_PADS_PAYOUT_STALE_MINUTES=120

WALLET_SIGNATURE_VERIFY_URL=
WALLET_SIGNATURE_VERIFY_API_KEY=
