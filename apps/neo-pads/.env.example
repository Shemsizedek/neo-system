PORT=8788
NEO_PADS_WEB_ORIGIN=

# Optional durable JSON store for single-instance deployments.
# Production multi-instance deployments should replace this runtime store with a transactional database adapter.
NEO_PADS_DATA_FILE=./data/neo-pads-runtime.json

# Counterparty / NEO Router
COUNTERPARTY_BALANCE_URL=
COUNTERPARTY_CORE_URL=
COUNTERPARTY_API_KEY=

# NEOpass
NEOPASS_API_URL=

# NEOworks
NEOWORKS_API_URL=

# NEO Counter browser checkout gateway
NEO_COUNTER_CHECKOUT_URL=
NEO_PADS_CHECKOUT_RETURN_URL=
NEO_PADS_CHECKOUT_CANCEL_URL=
NEO_COUNTER_WEBHOOK_SECRET=

# Optional NEO Counter runtime health endpoint / API credential for read-only canaries.
NEO_COUNTER_HEALTH_URL=
NEO_COUNTER_API_KEY=

# Bitcoin/Counterparty wallet message-signature verifier.
# NEO Pads never receives or stores private keys.
WALLET_SIGNATURE_VERIFY_URL=
WALLET_SIGNATURE_VERIFY_API_KEY=
