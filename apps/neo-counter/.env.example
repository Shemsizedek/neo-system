# Merchant receive address used only for read-only payment observation.
VITE_NEO_COUNTER_RECEIVE_ADDRESS=

# Optional provider overrides.
VITE_BLOCKSTREAM_API=https://blockstream.info/api
VITE_COUNTERPARTY_API=https://api.counterparty.io:4000/v2

# Preferred XCP/NOMNI pricing source: CES/NEO market packet endpoint.
# Expected packet includes a quotes[] collection produced by src/ces/publisher.ts.
VITE_CES_MARKET_PACKET_ENDPOINT=
VITE_CES_QUOTE_MAX_AGE_MS=300000

# Optional fallback quote service when CES has no fresh explicit USD quote.
# Expected response:
# {"unit_amount": 12.34, "source": "NEO market service", "expires_at": "2026-08-22T06:00:00Z"}
VITE_NEO_COUNTER_QUOTE_ENDPOINT=
