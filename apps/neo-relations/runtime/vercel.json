{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/health", "destination": "/api/index.js"},
    {"source": "/intents", "destination": "/api/index.js"},
    {"source": "/intents/:path*", "destination": "/api/index.js"},
    {"source": "/router/:path*", "destination": "/api/index.js"}
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  }
}
