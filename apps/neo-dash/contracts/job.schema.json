{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo.system/schemas/neo-dash/job.schema.json",
  "title": "NEO Dash Job",
  "type": "object",
  "required": ["id", "serviceType", "customerId", "pickup", "state", "commercialAmountWorld"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "serviceType": {
      "type": "string",
      "enum": ["RIDE", "FOOD", "PACKAGE", "GROCERY", "COURIER", "ERRAND"]
    },
    "customerId": { "type": "string", "minLength": 1 },
    "providerId": { "type": ["string", "null"] },
    "merchantId": { "type": ["string", "null"] },
    "pickup": { "$ref": "#/$defs/point" },
    "dropoff": { "$ref": "#/$defs/point" },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT", "QUOTED", "MATCHING", "OFFERED", "ACCEPTED", "PAYMENT_PENDING",
        "CONFIRMED", "ARRIVING", "PICKUP_READY", "IN_PROGRESS", "COMPLETED",
        "SETTLED", "CLOSED", "CANCELLED", "EXPIRED", "NO_PROVIDER", "REFUNDED",
        "DISPUTED", "SUSPENDED"
      ]
    },
    "commercialAmountWorld": { "type": "number", "minimum": 0 },
    "settlementAsset": { "type": ["string", "null"], "enum": ["BTC", "XCP", "NOMNI", null] },
    "networkAmount": { "type": ["number", "null"], "minimum": 0 },
    "checkoutId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
