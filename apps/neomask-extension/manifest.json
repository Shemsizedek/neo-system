{
  "manifest_version": 3,
  "name": "NeoMask — Bitcoin Wallet",
  "version": "0.2.0",
  "description": "Encrypted local Bitcoin vault, site permissions and reviewed P2PKH PSBT signing.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NeoMask"
  },
  "content_scripts": [
    {
      "matches": [
        "https://holytemples.org/*"
      ],
      "js": [
        "provider.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://holytemples.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
