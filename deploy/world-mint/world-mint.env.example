# Copy to /etc/neo/world-mint.env on the deployment host.
# chmod 600 /etc/neo/world-mint.env
# chown neo-world-mint:neo-world-mint /etc/neo/world-mint.env
# NEVER commit the populated file.

BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_AUTH=replace-with-rpc-user:replace-with-rpc-password
WORLD_MINT_PAYOUT_SCRIPT_HEX=replace-with-standard-bitcoin-scriptpubkey-hex

NEO_MINER_DB_PATH=/var/lib/neo-world-mint/neo-miner.sqlite
NIBIRU_POOL_ID=world-mint-genesis

# Set 0.0.0.0 only when the host firewall/security group intentionally exposes Stratum.
NIBIRU_STRATUM_HOST=127.0.0.1
NIBIRU_STRATUM_PORT=3333

# Health/status is intentionally loopback-only.
NIBIRU_HEALTH_HOST=127.0.0.1
NIBIRU_HEALTH_PORT=3334

NIBIRU_TEMPLATE_REFRESH_MS=15000
NIBIRU_CONFIRMATION_CHECK_MS=30000

# Leave false when Bitcoin Core is local. For remote RPC, use only a private authenticated network/VPN.
ALLOW_REMOTE_BITCOIN_RPC=false
