{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NEO Miner Cost Model",
  "type":"object",
  "required":["sku","currency","materials","assembly","test","packaging","logistics","warrantyReserve","overhead","targetGrossMarginPct"],
  "properties":{
    "sku":{"type":"string"},
    "currency":{"type":"string"},
    "materials":{"type":"number","minimum":0},
    "assembly":{"type":"number","minimum":0},
    "test":{"type":"number","minimum":0},
    "packaging":{"type":"number","minimum":0},
    "logistics":{"type":"number","minimum":0},
    "warrantyReserve":{"type":"number","minimum":0},
    "overhead":{"type":"number","minimum":0},
    "channelAllowance":{"type":"number","minimum":0},
    "landedCost":{"type":"number","minimum":0},
    "msrp":{"type":["number","null"],"minimum":0},
    "targetGrossMarginPct":{"type":"number","minimum":0,"maximum":100},
    "effectiveFrom":{"type":["string","null"],"format":"date"},
    "approvedBy":{"type":["string","null"]},
    "status":{"type":"string","enum":["DRAFT","APPROVED","RETIRED"]}
  }
}