{
  "service": "neogram",
  "product_name": "Neogram",
  "legacy_name": "NEO Telegram",
  "version": "0.4",
  "mode": "github-static",
  "status": "prototype",
  "protocol": "NTP/1.0",
  "protocol_name": "NEO Telegram Protocol",
  "network": "NVSN",
  "bridge": "NVSN-NT-BRIDGE-001",
  "backend": "GitHub repository + GitHub Actions static API",
  "frontend": "GitHub Pages",
  "persistent_messaging": "browser-local",
  "identity_directory": true,
  "routing_registry": true,
  "device_signing": "ECDSA-P256-SHA256 browser-local non-exportable private key",
  "signature_verification": true,
  "key_agreement": "ECDH-P256",
  "payload_encryption": "AES-GCM-256",
  "public_key_binding": "GitHub-published or browser-imported public binding",
  "nonce_replay_protection": "browser-local",
  "live_relay": false,
  "transports": ["INTERNET", "MESH", "SMS", "RADIO"],
  "settlement": {"bitcoin":"interface-only","lightning":"interface-only","counterparty":"interface-only"}
}
