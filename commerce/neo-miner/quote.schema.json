{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NEO Miner Commerce Quote",
  "type":"object",
  "properties":{
    "quote_id":{"type":"string"},
    "customer_id":{"type":"string"},
    "sku":{"type":"string"},
    "quantity":{"type":"number","minimum":0},
    "hashrate_th":{"type":"number","minimum":0},
    "base_currency":{"type":"string"},
    "payment_currency":{"type":"string"},
    "base_amount":{"type":"number","minimum":0},
    "fx_rate":{"type":"number","exclusiveMinimum":0},
    "fx_source":{"type":"string"},
    "tax_amount":{"type":"number","minimum":0},
    "shipping_or_hosting_fee":{"type":"number","minimum":0},
    "payment_fee":{"type":"number","minimum":0},
    "network_fee":{"type":"number","minimum":0},
    "total_amount":{"type":"number","minimum":0},
    "created_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "status":{"type":"string","enum":["DRAFT","ACTIVE","EXPIRED","ACCEPTED","CANCELLED"]},
    "simulation":{"type":"boolean","default":true}
  },
  "required":["quote_id","customer_id","sku","base_currency","payment_currency","base_amount","total_amount","created_at","expires_at","status","simulation"]
}
