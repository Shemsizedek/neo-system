{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"neo-command-board",
  "main":"src/index.js",
  "compatibility_date":"2026-09-13",
  "workers_dev":true,
  "observability":{"enabled":true},
  "durable_objects":{"bindings":[{"name":"COMMAND_STORE","class_name":"CommandStore"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["CommandStore"]}]
}
