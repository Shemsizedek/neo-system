{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"neo-memory-graph",
  "main":"src/index.js",
  "compatibility_date":"2026-09-13",
  "workers_dev":true,
  "observability":{"enabled":true},
  "durable_objects":{"bindings":[{"name":"MEMORY_GRAPH","class_name":"MemoryGraphStore"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["MemoryGraphStore"]}]
}
