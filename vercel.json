{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/neo-system/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/neo-system/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-NEO-Deployment-Role", "value": "backup" }
      ]
    }
  ]
}
