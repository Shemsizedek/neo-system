{
  "version": "1.2.0",
  "domainRoot": "holytemples.org",
  "dnsTarget": "ghs.googlehosted.com.",
  "runtime": "google-cloud-run",
  "frontend": "github-pages-or-service-ui",
  "hosts": [
    {"host":"neo.holytemples.org","service":"neo-system","role":"system-site-api"},
    {"host":"router.holytemples.org","service":"neo-router","role":"api"},
    {"host":"algo.holytemples.org","service":"neo-algo","role":"site-api"},
    {"host":"prime.holytemples.org","service":"neo-prime","role":"site-api"},
    {"host":"pay.holytemples.org","service":"neopay","role":"payments-wallet-entry-site-api"},
    {"host":"neobank.holytemples.org","service":"neo-bank","role":"community-ces-site-api"},
    {"host":"hub.holytemples.org","service":"neo-hub","role":"site-api"},
    {"host":"counter.holytemples.org","service":"neo-counter","role":"site-api"},
    {"host":"wire.holytemples.org","service":"neo-wire","role":"site-api"},
    {"host":"neogram.holytemples.org","service":"neogram","role":"site-api"},
    {"host":"neofx.holytemples.org","service":"neo-fx","role":"site-api"},
    {"host":"scan.holytemples.org","service":"neoscan","role":"token-explorer-site-api"},
    {"host":"school.holytemples.org","service":"gisd","role":"site-api"},
    {"host":"library.holytemples.org","service":"neo-library","role":"site-api"},
    {"host":"book.holytemples.org","service":"neo-books","role":"site-api"},
    {"host":"neopads.holytemples.org","service":"neo-pads","role":"site-api"},
    {"host":"neopass.holytemples.org","service":"neopass","role":"site-api"},
    {"host":"neovision.holytemples.org","service":"neo-tv","role":"site-api"},
    {"host":"noogle.holytemples.org","service":"noogle","role":"site-api"},
    {"host":"omnitrix.holytemples.org","service":"omnitrix","role":"site-api"},
    {"host":"neodash.holytemples.org","service":"neo-dash","role":"site-api"},
    {"host":"nomni.holytemples.org","service":"nomni","role":"currency-site-api"},
    {"host":"wallet.holytemples.org","service":"neo-treasury-wallet","role":"wallet-api"},
    {"host":"treasury.holytemples.org","service":"world-treasury","role":"treasury-site-api"}
  ],
  "treasury": {
    "network": "bitcoin-counterparty",
    "walletAddress": "18FyntJG9hdXYvanm67mGgbyo1P7adckvg",
    "settlementPolicy": "all-enabled-NEO-service settlement instructions reference the treasury wallet unless an explicit service contract overrides it"
  },
  "assetPolicy": {
    "nomniMetadata": "https://nomni.holytemples.org/nomni.json",
    "nomniValuation": "https://nomni.holytemples.org/api/nomni/value",
    "nomniSymbol": "∞",
    "nomniValuationMode": "market-observed-not-guaranteed-redemption-peg",
    "nomniExternalReference": "https://xcp.coindaddy.io/NOMNI.json",
    "worldCurrencyReference": "https://holytemples.org/world-currency/",
    "neoCashPresentation": "application-facing base/quote asset",
    "counterpartyNativeBase": "XCP",
    "wrappingMode": "adapter-alias-until-an-on-chain-wrapper-contract-is-explicitly-deployed"
  },
  "ces": {
    "host": "neobank.holytemples.org",
    "database": "google-cloud-firestore",
    "databaseHealthEndpoint": "/api/database/health",
    "walletEntry": "https://pay.holytemples.org",
    "policy": "NEO Bank is community CES access; Bitcoin/Counterparty wallet recovery and signing remain in NEOpay; CES mutations require authenticated backend authorization"
  },
  "rules": {
    "publicDnsDoesNotImplyServiceReady": true,
    "cloudRunMappingRequiredPerHost": true,
    "tlsRequired": true,
    "secretsRuntimeOnly": true,
    "defaultDenyPrivilegedRoutes": true,
    "neverEmbedPrivateKeys": true
  }
}
