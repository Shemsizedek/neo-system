{
  "schema_version": 1,
  "project": "NEO System — Project 144",
  "integration": "modern-treasury",
  "reviewed_on": "2026-10-29",
  "accountable_owner": "NEOsync",
  "workstreams": ["NEO Core", "NEO Counter", "NEO Merchant Treasury"],
  "purpose": "Verify a restricted sandbox API key and discover sandbox internal accounts without moving money or changing NEO ledger balances.",
  "source_host": "server/neo-merchant-treasury/server.mjs",
  "staging_source_host": "server/neo-merchant-treasury/modern-treasury-staging.mjs",
  "staging_plan": {
    "provider": "Render",
    "service_name": "neo-modern-treasury-staging",
    "region": "virginia",
    "plan": "free",
    "branch": "feat/project144-modern-treasury-sandbox",
    "auto_deploy": false,
    "credential_state": "absent_pending_restricted_key_approval"
  },
  "upstream_origin": "https://app.moderntreasury.com",
  "environment": "sandbox",
  "access": "NEO_MERCHANT_TREASURY_OPERATOR_TOKEN",
  "upstream_methods": ["GET"],
  "upstream_paths": ["/api/api_keys/current", "/api/ping", "/api/internal_accounts"],
  "secret_variables": ["MODERN_TREASURY_ORGANIZATION_ID", "MODERN_TREASURY_API_KEY"],
  "controls": {
    "server_side_credentials_only": true,
    "reject_production_keys": true,
    "reject_manage_permissions": true,
    "verify_key_before_each_account_page": true,
    "follow_redirects": false,
    "request_timeout_ms": 10000,
    "max_response_bytes": 2097152,
    "account_projection": ["id", "currency", "live_mode"],
    "pagination": "Use X-After-Cursor, including on empty pages; do not infer completion from page length.",
    "payment_execution_enabled": false,
    "webhook_receiver_enabled": false,
    "automatic_ledger_credit_enabled": false
  },
  "readiness": {
    "source_implementation": "implemented",
    "account_access": "signed_in_sandbox_dashboard_verified",
    "credentials": "not_provisioned_or_tested",
    "deployment": "not_attempted",
    "end_to_end_connection": "not_verified"
  },
  "dependencies": [
    "Signed-in sandbox dashboard access is verified; no new account agreements have been accepted by this integration.",
    "Owner supplies a sandbox key restricted to Accounts Read and Developer Read in the existing server secret manager.",
    "Deploy and test the isolated free Render staging host, leaving credentials absent until approval."
  ],
  "next_milestone": "Authenticated sandbox key verification plus operator-only account discovery on the selected staging runtime.",
  "runbook": "docs/integrations/modern-treasury.md"
}
