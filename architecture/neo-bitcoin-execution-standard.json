{
  "schema_version": 1,
  "standard": "NEO Bitcoin-first NVM/BVM integration gate",
  "scope": "neo-system/bitcoin-dependent-capabilities",
  "status": "PROPOSED_NO_PRODUCTION_SWITCH",
  "principles": {
    "bitcoin_consensus": "Bitcoin Core is authoritative for Bitcoin consensus/chain evidence; NVM/BVM do not change it",
    "counterparty": "Existing Counterparty API v2 remains separate from Bitcoin Core JSON-RPC",
    "core_control_plane": "NEO Core mediates application access; frontends have no node credentials",
    "rpc_credentials": "runtime secret store only; never expose in browser or GitHub",
    "new_projects": "fail-closed until classified",
    "evm_runtime_enabled": false,
    "ethereum_bridge_enabled": false,
    "bitcoin_mainnet_bvm_enabled": false,
    "custody_or_signing_from_vm": false,
    "existing_rails_unchanged": true
  },
  "profiles": [
    "core-only",
    "bitcoin-gateway",
    "bitcoin-observer",
    "external-signer",
    "architecture-review-required",
    "vm-regtest"
  ],
  "plans": {
    "bitcoin.observe": "NEO_CORE_BITCOIN_READ_GATEWAY",
    "counterparty.observe": "NEO_CORE_COUNTERPARTY_API_V2_GATEWAY",
    "bvm.validate": "NEO_PRIVATE_VM_REGTEST_ONLY"
  },
