    "EVIDENCE":{"retention_days":0,"replicas":3},
    "MEDIA":{"retention_days":3650,"replicas":2},
    "CROWN_RECORD":{"retention_days":0,"replicas":3},
    "OPERATIONAL_MEMORY":{"retention_days":730,"replicas":2},
