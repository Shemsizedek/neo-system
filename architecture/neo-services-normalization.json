{
  "version": "1.1.1",
  "standard": "architecture/neo-services-platform.json",
  "scope": "apps-directory",
  "planes": {
    "backend": "github",
    "frontend": "github-pages",
    "serverApi": "discord"
  },
  "apps": [
    {"id":"gisd"},
    {"id":"neo-counter"},
    {"id":"neo-exchange"},
    {"id":"neo-guardian"},
    {"id":"neo-pads"},
    {"id":"neo-prime"},
    {"id":"neo-relations"},
    {"id":"neo-telegram"},
    {"id":"neo-tv"},
    {"id":"neopay"},
    {"id":"neoscan"},
    {"id":"noogle"},
    {"id":"omnitrix-android"},
    {"id":"omnitrix"}
  ],
  "legacyStandaloneDeployments": [
    {"workflow":".github/workflows/neo-counter-cloudflare.yml","service":"neo-counter","status":"disabled"},
    {"workflow":".github/workflows/neopay-cloudflare.yml","service":"neopay","status":"disabled"},
    {"workflow":".github/workflows/neo-enterprise-cloudflare.yml","service":"neo-enterprise","status":"disabled"},
    {"workflow":".github/workflows/neo-enterprise-federation-cloudflare.yml","service":"neo-enterprise-federation","status":"disabled"},
    {"workflow":".github/workflows/neo-government-cloudflare.yml","service":"neo-government","status":"disabled"},
    {"workflow":".github/workflows/neo-pacer-cloudflare.yml","service":"neo-pacer","status":"disabled"},
    {"workflow":".github/workflows/neoscan-statements-cloudflare.yml","service":"neoscan-statements","status":"disabled"}
  ],
  "pages": {
    "deploymentOwner": ".github/workflows/pages.yml",
    "routeRegistry": "architecture/neo-pages-routes.json",
    "singleArtifact": true,
    "serviceSpecificDeployments": false
  },
  "allowedTransportBridges": [
    {
      "workflow": ".github/workflows/deploy-neo-discord.yml",
      "role": "thin-discord-https-bridge",
      "mayOwnNeoBusinessLogic": false,
      "mayBecomeNeoBackend": false
    }
  ],
  "rules": {
    "standaloneCloudflareServiceBackend": false,
    "standaloneVercelServiceBackend": false,
    "githubPagesSecrets": false,
    "singleGitHubPagesDeploymentOwner": true,
    "transportOwnsBusinessLogic": false
  }
}
