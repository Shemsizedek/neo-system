{
  "version": "2.0.0",
  "standard": "architecture/neo-services-platform.json",
  "scope": "neo-system",
  "planes": {
    "sourceControl": "github",
    "ciCd": "github-actions",
    "frontend": "github-pages",
    "persistentData": "firestore",
    "serviceRuntime": "provider-independent",
    "transport": "discord"
  },
  "apps": [
    {"id":"gisd"},{"id":"neo-counter"},{"id":"neo-dash"},{"id":"neo-exchange"},{"id":"neo-guardian"},{"id":"neo-pads"},{"id":"neo-prime"},{"id":"neo-realty"},{"id":"neo-relations"},{"id":"neo-telegram"},{"id":"neo-tv"},{"id":"neopay"},{"id":"neoscan"},{"id":"noogle"},{"id":"omnitrix-android"},{"id":"omnitrix"}
  ],
  "pages": {
    "deploymentOwner": ".github/workflows/pages.yml",
    "routeRegistry": "architecture/neo-pages-routes.json",
    "singleArtifact": true,
    "serviceSpecificDeployments": false
  },
  "persistence": {
    "primary": "firestore",
    "credentials": "runtime-identity-iam",
    "allowProcessMemoryFallback": false,
    "allowFrontendSecretAccess": false,
    "dataAccess": "service-runtime-only"
  },
  "migrationExceptions": [
    {
      "service": "neo-counter",
      "currentStore": "upstash-redis",
      "targetStore": "firestore",
      "status": "migration-required",
      "reason": "existing hosted adapter is Redis-specific and must not be mislabeled as Firestore"
    }
  ],
  "allowedTransportBridges": [
    {
      "workflow": ".github/workflows/deploy-neo-discord.yml",
      "role": "thin-discord-https-bridge",
      "mayOwnNeoBusinessLogic": false,
      "mayBecomeNeoBackend": false
    }
  ],
  "prohibitedCoreDependencies": ["vercel"],
  "rules": {
    "standaloneCloudflareServiceBackend": false,
    "standaloneVercelServiceBackend": false,
    "vercelCoreDependency": false,
    "vercelServiceRuntime": false,
    "firestorePrimaryPersistentStore": true,
    "githubOwnsSourceCode": true,
    "githubActionsOwnsCiCd": true,
    "githubPagesOwnsStaticFrontend": true,
    "serviceRuntimeOwnsBusinessLogic": true,
    "githubPagesSecrets": false,
    "singleGitHubPagesDeploymentOwner": true,
    "transportOwnsBusinessLogic": false
  }
}
