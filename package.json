{
  "name": "neo-teller",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {"node":"24.x"},
  "scripts": {
    "dev":"vite",
    "build":"tsc -b && vite build",
    "test":"node --test server/neo-router/*.test.mjs server/neo-prime/*.test.mjs server/neo-platform-api/*.test.mjs core/neo-algo/*.test.mjs server/tribunal-backend/*.test.mjs server/miner-agent/*.test.mjs server/miner-agent/adapters/*.test.mjs server/miner-controller/*.test.mjs server/miner-commerce/*.test.mjs server/miner-generator/*.test.mjs server/neo-counter-backend/*.test.mjs server/neo-evidence-vault/*.test.mjs",
    "preview":"vite preview",
    "crawl:neo":"node scripts/neo-sync-crawl.mjs",
    "router:worker":"node scripts/neo-router-worker.mjs",
    "tribunal:server":"node server/tribunal-backend/server.mjs",
    "tribunal:backup":"node server/tribunal-backend/backup.mjs",
    "miner:agent":"node server/miner-agent/agent.mjs",
    "miner:agent:test":"node --test server/miner-agent/*.test.mjs server/miner-agent/adapters/*.test.mjs",
    "miner:controller":"node server/miner-controller/controller.mjs",
    "miner:controller:test":"node --test server/miner-controller/*.test.mjs",
    "miner:commerce:test":"node --test server/miner-commerce/*.test.mjs",
    "miner:generator:test":"node --test server/miner-generator/*.test.mjs",
    "neo-counter:server":"node server/neo-counter-backend/server.mjs",
    "neo-counter:server:test":"node --test server/neo-counter-backend/*.test.mjs",
    "neo-evidence:server":"node server/neo-evidence-vault/server.mjs",
    "neo-evidence:test":"node --test server/neo-evidence-vault/*.test.mjs",
    "neo-teller:server":"node server/neo-teller-backend/server.mjs",
    "neo-platform:server":"node server/neo-platform-api/server.mjs",
    "neo-platform:test":"node --test server/neo-platform-api/*.test.mjs",
    "pages:platform-api":"node scripts/build-pages-platform-api.mjs"
  },
  "dependencies": {"react":"^19.1.1","react-dom":"^19.1.1","lucide-react":"^0.468.0"},
  "devDependencies": {"@vitejs/plugin-react":"^4.3.4","vite":"^6.0.7","typescript":"^5.7.2","@types/react":"^19.0.3","@types/react-dom":"^19.0.2"}
}
