{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neotherapy Credential",
  "type": "object",
  "required": [
    "id",
    "practitionerId",
    "level",
    "status",
    "modalities"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "practitionerId": {
      "type": "string"
    },
    "level": {
      "enum": [
        "C.Neo.",
        "S.Neo.",
        "M.Neo."
      ]
    },
    "status": {
      "enum": [
        "PENDING",
        "ACTIVE",
        "LIMITED",
        "SUSPENDED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}