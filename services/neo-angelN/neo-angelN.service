[Unit]
Description=NEO Angel - authorized background observations
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/neo-angelN/config.json
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/node /opt/neo-angelN/angelN.mjs --config /etc/neo-angelN/config.json --state-dir /var/lib/neo-angelN
StateDirectory=neo-angelN
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
