# NEO VPN Discord-only Gateway mode
DISCORD_APPLICATION_ID=<DISCORD_APPLICATION_ID>
DISCORD_GUILD_ID=<NEO_VPN_GUILD_ID>
# Runtime secret only. Never commit the real bot token.
DISCORD_BOT_TOKEN=<SECRET_STORE_ONLY>

# Authorization is based on immutable Discord role IDs, never role names.
NEO_VPN_DISCORD_VIEWER_ROLE_IDS=<ROLE_ID_1,ROLE_ID_2>
NEO_VPN_DISCORD_OPERATOR_ROLE_IDS=<ROLE_ID_1,ROLE_ID_2>
NEO_VPN_DISCORD_ADMIN_ROLE_IDS=<ROLE_ID_1>

# Keep false until a real WireGuard/local gateway execution adapter exists and passes acceptance.
NEO_VPN_INFRASTRUCTURE_LIVE=false

# Legacy webhook mode only; not required by Discord Gateway mode.
# DISCORD_PUBLIC_KEY=<64_HEX_CHARACTER_DISCORD_APPLICATION_PUBLIC_KEY>
