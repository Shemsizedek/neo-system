# Public hostname or IP of the NEO VPN gateway.
NEO_VPN_HOST=vpn.example.org

# WireGuard UDP port.
NEO_VPN_PORT=51820

# Private VPN subnet.
NEO_VPN_SUBNET=10.144.0.0/16

# Optional DNS resolver reachable by VPN peers.
NEO_VPN_DNS=10.144.1.1

# Never place WireGuard private keys in this file or commit them to Git.
