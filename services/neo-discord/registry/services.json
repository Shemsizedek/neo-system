{
  "version": "1.3.3",
  "planes": {"backend":"github","frontend":"github-pages","serverApi":"discord"},
  "defaultCommand": "services",
  "readActions": {
    "details": {"grounding":"registry","mutates":false},
    "status": {"grounding":["github-main-path","github-pages-route"],"mutates":false,"scope":"control-plane-reachability"},
    "read": {"grounding":"service-specific-approved-read-sources","mutates":false,"scope":"curated-service-read-adapter"},
    "operator": {"grounding":"configured-authenticated-runtime","mutates":false,"requiresOperator":true,"scope":"protected-aggregate-operational-read"}
  },
  "readAdapters": {
    "neopay": ["github-pages:/api/router/providers.json","github-pages:/api/router/state.json"],
    "neoscan": ["github-pages:/api/neoscan/statements/index.json"],
    "neo-counter": ["github-pages:/api/neo-counter/runtime.json","github-pages:/api/neo-counter/build.json"],
    "neo-exchange": ["github-pages:/api/platforms/neo-exchange.json"],
    "neo-relations": ["github-main:apps/neo-relations/runtime"]
  },
  "operatorReadAdapters": {
    "neo-miner": {"source":"runtime-env:NEO_MINER_OPERATOR_URL","auth":"runtime-secret:NEO_MINER_OPERATOR_TOKEN","mutates":false,"approvedSummary":"operational-scalars-only"},
    "neo-relations": {"source":"runtime-env:NEO_RELATIONS_OPERATOR_URL","auth":"runtime-secret:NEO_RELATIONS_OPERATOR_TOKEN","mutates":false,"aggregateOnly":true,"pii":false}
  },
  "rules": {
    "transportOwnsBusinessLogic": false,
    "discordSensitiveExecution": false,
    "discordApproval": false,
    "aiApproval": false,
    "serviceStatusMayImplyApplicationHealth": false,
    "readAdaptersMayMutate": false,
    "readAdaptersMayExposeProtectedRelationsData": false,
    "operatorReadRequiresRbac": true,
    "operatorReadMutation": false,
    "operatorReadMayExposeSecrets": false,
    "operatorReadMayApprove": false,
    "operatorReadPublicFallback": false
  },
  "services": [
    {"id":"gisd","name":"GISD / NEO Cipher","githubPath":"apps/gisd","pagesPath":null,"specializedCommand":null,"visibility":"internal"},
    {"id":"neo-counter","name":"NEO Counter","githubPath":"apps/neo-counter","pagesPath":"/neo-counter/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-dash","name":"NEO Dash","githubPath":"apps/neo-dash","pagesPath":null,"specializedCommand":null,"visibility":"public"},
    {"id":"neo-exchange","name":"NEO Exchange","githubPath":"apps/neo-exchange","pagesPath":"/neo-exchange/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-guardian","name":"NEO Guardian","githubPath":"apps/neo-guardian","pagesPath":"/guardian/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-pads","name":"NEO Pads","githubPath":"apps/neo-pads","pagesPath":null,"specializedCommand":null,"visibility":"public"},
    {"id":"neo-prime","name":"NEO Prime","githubPath":"apps/neo-prime","pagesPath":"/neo-prime/","specializedCommand":"neo","visibility":"public"},
    {"id":"neo-relations","name":"NEO Relations","githubPath":"apps/neo-relations","pagesPath":"/neo-relations/","specializedCommand":"relations","visibility":"public"},
    {"id":"neo-realty","name":"NEO Realty","githubPath":"apps/neo-realty","pagesPath":null,"specializedCommand":null,"visibility":"public"},
    {"id":"neo-telegram","name":"Neogram / NEO Telegram","githubPath":"apps/neo-telegram","pagesPath":"/neogram/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-tv","name":"NEO TV","githubPath":"apps/neo-tv","pagesPath":"/neo-tv/","specializedCommand":null,"visibility":"public"},
    {"id":"neopay","name":"NEOpay","githubPath":"apps/neopay","pagesPath":"/neopay/","specializedCommand":null,"visibility":"public"},
    {"id":"neoscan","name":"NEOscan","githubPath":"apps/neoscan","pagesPath":"/neoscan/","specializedCommand":null,"visibility":"public"},
    {"id":"noogle","name":"Noogle","githubPath":"apps/noogle","pagesPath":"/noogle/","specializedCommand":null,"visibility":"public"},
    {"id":"omnitrix-android","name":"Omnitrix Android","githubPath":"apps/omnitrix-android","pagesPath":null,"specializedCommand":null,"visibility":"internal"},
    {"id":"omnitrix","name":"Omnitrix","githubPath":"apps/omnitrix","pagesPath":"/omnitrix/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-pacer","name":"NEO-PACER","githubPath":"docs/neo-pacer","pagesPath":"/neo-pacer/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-enterprise","name":"NEO Enterprise","githubPath":"docs/neo-enterprise","pagesPath":"/neo-enterprise/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-hub","name":"NEO Hub","githubPath":"docs/neo-hub","pagesPath":"/neo-hub/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-oracle","name":"NEO Oracle","githubPath":"docs/neo-oracle","pagesPath":"/neo-oracle/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-lingo","name":"NEO Lingo","githubPath":"docs/neo-lingo","pagesPath":"/neo-lingo/","specializedCommand":null,"visibility":"public"},
    {"id":"neo-algo","name":"NEO Algo","githubPath":"docs/neo-algo","pagesPath":"/neo-algo/","specializedCommand":null,"visibility":"public"},
