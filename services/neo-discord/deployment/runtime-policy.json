{
  "version": "2.0.0",
  "service": "neo-discord",
  "platformStandard": "architecture/neo-services-platform.json",
  "sourceOfTruth": "github",
  "frontendPlane": "github-pages",
  "serverApiPlane": "discord",
  "transportBridges": {
    "active": "cloudflare-worker",
    "portableReference": "node-http",
    "cloudflare-worker": {
      "path": "services/neo-discord/adapters/cloudflare",
      "classification": "thin-transport-bridge",
      "ownsBusinessLogic": false,
      "healthPath": "/health",
      "interactionPath": "/discord/interactions",
      "deployed": true
    },
    "node-http": {
      "path": "services/neo-discord/adapters/node-http",
      "classification": "portable-transport-reference",
      "ownsBusinessLogic": false,
      "healthPath": "/health",
      "interactionPath": "/discord/interactions",
      "deployed": false
    }
  },
  "rules": {
    "discordIsPrimaryServerApiPlane": true,
    "githubIsPrimaryBackendPlane": true,
    "githubPagesIsPrimaryFrontendPlane": true,
    "transportBridgeMayBecomeBackend": false,
    "automaticTransportPromotion": false,
    "mayChangeAuthorizationPolicy": false,
    "mayEnableSensitiveExecution": false,
    "mayApproveIntents": false
  }
}
