# NEO Wire live read-only connectors
VITE_BITCOIN_ESPLORA_URL=https://blockstream.info/api
VITE_COUNTERPARTY_API_URL=https://api.counterparty.io:4000/v2

# NEO Router server-only model credentials.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# NEO_ROUTER_DEFAULT_ORCHESTRATOR=anthropic
# NEO_ROUTER_MAX_HOPS=6

# Airbyte Agent Engine connector instance bindings.
# AIRBYTE_GITHUB_CONNECTOR_ID=
# AIRBYTE_GITLAB_CONNECTOR_ID=
# AIRBYTE_ASANA_CONNECTOR_ID=
# AIRBYTE_GMAIL_CONNECTOR_ID=
# AIRBYTE_SEARCH_CONSOLE_CONNECTOR_ID=
# AIRBYTE_TIKTOK_MARKETING_CONNECTOR_ID=

# Mission Engine durable state and authenticated control plane.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEO_ROUTER_STATE_KEY=neo-router:mission-engine:v7
# NEO_ROUTER_CONTROL_TOKEN=

# Mission Engine v6 live connector agents. Server/Actions secrets only.
# NEO_GITHUB_TOKEN=
# NEO_GITHUB_REPOSITORY=Shemsizedek/neo-system
# ASANA_ACCESS_TOKEN=
# GMAIL_ACCESS_TOKEN=
# AIRBYTE_AGENT_ENGINE_URL=
# AIRBYTE_AGENT_ENGINE_TOKEN=

# Mission Engine v7 event ingress. Never expose these in VITE_ variables.
# NEO_ROUTER_GITHUB_WEBHOOK_SECRET=
# NEO_ROUTER_EVENT_TOKEN=
