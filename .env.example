# NEO Teller v0.2 read-only live-data gateway
NEO_TELLER_PORT=8787
COUNTERPARTY_API_URL=
BITCOIN_ELECTRS_URL=https://blockstream.info/api

# Frontend points to the read-only gateway above.
VITE_NEO_TELLER_API_URL=http://localhost:8787

# NEO Evidence Vault
NEO_EVIDENCE_PORT=8791
NEO_EVIDENCE_DB_PATH=data/neo-evidence-vault.sqlite
NEO_EVIDENCE_ALLOWED_ORIGIN=https://shemsizedek.github.io
NEO_EVIDENCE_API_TOKEN=
VITE_NEO_EVIDENCE_API_URL=http://localhost:8791
VITE_NEO_EVIDENCE_API_TOKEN=

# NEO CES Bridge — Discord-primary, Cloudflare-independent.
# Modes: status | api-readonly | session-readonly
NEO_CES_MODE=status
CES_ENDPOINT=
CES_SESSION_READ_URL=
CES_NETWORK=
CES_ACCOUNT=
CES_API_TOKEN=
# CES_SESSION_COOKIE is intentionally omitted here. Supply short-lived authorized
# session material only at runtime (for example, as a protected CI/runtime secret).

# NEO Router v2 server-only provider mesh. Never prefix secrets with VITE_.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# NEO_ROUTER_PROVIDER_TIMEOUT_MS=30000
