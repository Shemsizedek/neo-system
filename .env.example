# NEO Wire live read-only connectors
# Public Bitcoin Esplora endpoint; self-host for production privacy/resilience.
VITE_BITCOIN_ESPLORA_URL=https://blockstream.info/api

# Counterparty Core API v2 endpoint. Replace with your own production node when available.
VITE_COUNTERPARTY_API_URL=https://api.counterparty.io:4000/v2

# Optional health-only endpoints. Leave unset until nodes/providers are provisioned.
# VITE_LIGHTNING_HEALTH_URL=https://your-lightning-gateway.example/health
# VITE_TELECOM_HEALTH_URL=https://your-telecom-gateway.example/health

# NEO Router server-only credentials. Never prefix these with VITE_ or expose
# them to browser code. Configure only the providers you intend to enable.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# NEO_ROUTER_DEFAULT_ORCHESTRATOR=anthropic
# NEO_ROUTER_MAX_HOPS=6

# Airbyte Agent Engine connector instance bindings.
# Values belong only in the deployment/runtime secret store; never commit live IDs.
# AIRBYTE_GITHUB_CONNECTOR_ID=
# AIRBYTE_GITLAB_CONNECTOR_ID=
# AIRBYTE_ASANA_CONNECTOR_ID=
# AIRBYTE_GMAIL_CONNECTOR_ID=
# AIRBYTE_SEARCH_CONSOLE_CONNECTOR_ID=
# AIRBYTE_TIKTOK_MARKETING_CONNECTOR_ID=

# Mission Engine durable state and authenticated control plane.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEO_ROUTER_STATE_KEY=neo-router:mission-engine:v6
# NEO_ROUTER_CONTROL_TOKEN=

# Mission Engine v6 live connector agents. Server/Actions secrets only.
# NEO_GITHUB_TOKEN=
# NEO_GITHUB_REPOSITORY=Shemsizedek/neo-system
# ASANA_ACCESS_TOKEN=
# GMAIL_ACCESS_TOKEN=
# AIRBYTE_AGENT_ENGINE_URL=
# AIRBYTE_AGENT_ENGINE_TOKEN=
