{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "neopass": {
      "type": "streamable-http",
      "url": "https://YOUR_VERIFIED_NEO_PASS_HOST/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "provided", "clientId": "YOUR_REGISTERED_CHATGPT_CLIENT_ID", "tokenEndpointAuthMethod": "none"},
            "baseScopes": ["neopass:profile", "neopass:services"]
          }
        }
      }
    }
  }
}
