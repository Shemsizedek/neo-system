{
  "name": "MiningTelemetry",
  "type": "object",
  "properties": {
    "miner_id": {"type":"string"},
    "timestamp": {"type":"string","format":"date-time"},
    "hashrate_th": {"type":"number"},
    "power_w": {"type":"number"},
    "temperature_c": {"type":"number"},
    "fan_rpm": {"type":"number"},
    "efficiency_j_th": {"type":"number"},
    "accepted_shares": {"type":"integer"},
    "rejected_shares": {"type":"integer"},
    "pool_latency_ms": {"type":"number"},
    "simulation": {"type":"boolean","default":true}
  },
  "required": ["miner_id","timestamp"]
}
