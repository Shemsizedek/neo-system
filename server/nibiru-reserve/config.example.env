NIBIRU_RESERVE_DB_PATH=/var/lib/nibiru/nibiru-reserve.sqlite
NIBIRU_TRUST_KEYS_PATH=/run/secrets/nibiru-attestation-public-keys.json
NIBIRU_ISO_XSD_PATH=/opt/nibiru/iso20022/pain.001.001.13.xsd
NIBIRU_ISO_XSD_SHA256=replace_with_verified_64_character_sha256
NIBIRU_XSD_EXECUTABLE=xmllint
NIBIRU_BACKUP_PATH=/var/backups/nibiru/nibiru-reserve-YYYYMMDD.nib
NIBIRU_RESTORE_PATH=/var/lib/nibiru-recovery/nibiru-reserve.sqlite
# Supply NIBIRU_BACKUP_PASSPHRASE only through the deployment secret manager.
