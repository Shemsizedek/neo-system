[Unit]
Description=NEO Miner Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neo-miner
Group=neo-miner
WorkingDirectory=/opt/neo-system
Environment=NODE_ENV=production
Environment=NEO_MINER_CONTROLLER_CONFIG=/etc/neo-miner-controller/config.json
ExecStart=/usr/bin/node /opt/neo-system/server/miner-controller/controller.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neo-miner-controller /var/log/neo-miner-controller

[Install]
WantedBy=multi-user.target
