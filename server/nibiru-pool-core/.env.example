# World Mint Genesis Pool runtime
# Copy these values into your deployment secret store. Never commit real credentials.

BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_AUTH=bitcoin-rpc-user:bitcoin-rpc-password
WORLD_MINT_PAYOUT_SCRIPT_HEX=0014...

NEO_MINER_DB_PATH=./data/neo-miner.sqlite
NIBIRU_POOL_ID=world-mint-genesis
NIBIRU_STRATUM_HOST=0.0.0.0
NIBIRU_STRATUM_PORT=3333
NIBIRU_HEALTH_HOST=127.0.0.1
NIBIRU_HEALTH_PORT=3334
NIBIRU_TEMPLATE_REFRESH_MS=15000
NIBIRU_CONFIRMATION_CHECK_MS=30000

# Optional Stratum smoke-test inputs. Prefer CLI flags or ephemeral shell secrets.
# Never commit an actual worker secret.
NIBIRU_SMOKE_WORKER=
NIBIRU_SMOKE_SECRET=

# Security: leave unset/false in production unless Bitcoin RPC is protected by a private network/VPN.
ALLOW_REMOTE_BITCOIN_RPC=false
