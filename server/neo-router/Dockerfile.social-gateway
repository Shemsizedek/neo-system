FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
ENV NODE_ENV=production
COPY server/neo-router ./server/neo-router
COPY server/neo-platform-api ./server/neo-platform-api
ENV HOST=0.0.0.0
ENV PORT=8080
EXPOSE 8080
CMD ["node", "server/neo-router/social-gateway-start.mjs"]
