# NEO Miner Production Connection Gate
# Copy into your runtime secret manager / environment. Never commit real secrets.

PORT=8890
CORS_ORIGIN=https://console.neo.example.com
NEO_MINER_API_TOKEN=replace-in-secret-manager

# Restart-safe financial state. Mount the parent directory on persistent storage.
NEO_MINER_DB_PATH=/var/lib/neo-miner/neo-miner.sqlite

# Human operator control plane / BFF
NEO_OPERATOR_PORT=8891
# Exact browser origin allowed to call the operator BFF.
NEO_OPERATOR_ORIGIN=https://console.neo.example.com
# Public HTTPS URL of the operator BFF itself.
NEO_OPERATOR_PUBLIC_URL=https://operator.neo.example.com
# Require both public hosts to live under this private site suffix.
NEO_OPERATOR_SITE_SUFFIX=neo.example.com
NEO_OPERATOR_REQUIRE_SAME_SITE=true
NEO_MINER_INTERNAL_API_URL=http://127.0.0.1:8890
# 32+ random bytes; keep only in the runtime secret manager.
NEO_OPERATOR_SESSION_SECRET=
NEO_OPERATOR_SESSION_TTL_SEC=1800
NEO_OPERATOR_COOKIE_SECURE=true
# Same-site deployment uses Lax; startup rejects None when REQUIRE_SAME_SITE=true.
NEO_OPERATOR_COOKIE_SAMESITE=Lax
# JSON array of operator records. Store only scrypt password hashes, never plaintext passwords.
# Example structure: [{"id":"ops1","displayName":"Operator One","role":"TREASURY","passwordHash":"scrypt$..."}]
NEO_OPERATOR_ACCOUNTS_JSON=[]

# Browser build: public URL only. Do NOT define VITE_NEO_MINER_OPERATOR_TOKEN.
# GitHub repository variable NEO_MINER_OPERATOR_API should equal NEO_OPERATOR_PUBLIC_URL.
# VITE_NEO_MINER_OPERATOR_API=https://operator.neo.example.com

# Bitcoin Core network / node RPC
BITCOIN_ENABLED=false
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_AUTH=
BITCOIN_RPC_TIMEOUT_MS=10000
BITCOIN_CONNECTED=false
BITCOIN_HEIGHT=

# Bitcoin Core wallet RPC used only by the production backend.
BITCOIN_WALLET_RPC_URL=
BITCOIN_WALLET_RPC_AUTH=

# Treasury / payout controls
PAYOUT_MIN_BTC=0.00001
PAYOUT_CONFIRMATIONS=1
TREASURY_DAILY_LIMIT_BTC=0.25
TREASURY_HOT_FLOOR_BTC=0.02
TREASURY_HOT_TARGET_BTC=0.10
TREASURY_COLD_MIN_BTC=0.50
TREASURY_HOT_BALANCE_BTC=0
TREASURY_COLD_BALANCE_BTC=0
TREASURY_FEE_RATE_SAT_VB=5
TREASURY_CHANGE_ADDRESS_REF=wallet://hot/change
TREASURY_SIGNING_MODE=EXTERNAL_SIGNER

# Counterparty API v2
COUNTERPARTY_ENABLED=false
COUNTERPARTY_API_URL=http://127.0.0.1:4000
COUNTERPARTY_CONNECTED=false
COUNTERPARTY_HEIGHT=

# Mining pool / Stratum
MINING_POOL_ENABLED=false
MINING_POOL_ENDPOINT=stratum+tcp://pool.example:3333
POOL_CONNECTED=false
ACCEPTED_SHARES=0
REJECTED_SHARES=0

# Verified NEO Miner agents
MINER_AGENTS_ENABLED=false
VERIFIED_MINER_AGENTS=0
MINERS_ONLINE=0
FLEET_HASHRATE_TH=0

# Live FX
FX_ENABLED=false
FX_API_URL=https://fx-provider.example/rates
FX_SOURCE=

# World Currency payment provider
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_VERIFY=false
ENABLED_CURRENCIES=USD,EUR,GBP,CAD,AUD

# Persistence + compliance
CONTRACT_STORE=PERSISTENT
SETTLEMENT_STORE=PERSISTENT
COMPLIANCE_ENABLED=false
COMPLIANCE_POLICY=FAIL_CLOSED
