{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-system.local/protocol/neo-canonical/v1/event.schema.json",
  "title": "NEO Canonical Event v1",
  "description": "Platform-neutral event envelope for communication across NEO System adapters and services.",
  "type": "object",
  "additionalProperties": false,
  "required": ["neo_version", "event_id", "event_type", "source", "destination", "permissions", "payload", "trace"],
  "properties": {
    "neo_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "source": { "$ref": "#/$defs/endpoint" },
    "destination": { "$ref": "#/$defs/endpoint" },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "subject_id": { "type": "string" },
        "subject_type": { "type": "string", "enum": ["user", "service", "bot", "system", "unknown"] }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["read-only", "write", "execute"] },
        "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "payload": { "type": "object", "additionalProperties": true },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_id", "timestamp"],
      "properties": {
        "correlation_id": { "type": "string", "minLength": 1 },
        "causation_id": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "adapter"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "service": { "type": "string" }
      }
    }
  }
}
